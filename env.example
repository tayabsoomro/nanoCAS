# Copy to .env (repo root or server/) and adjust.
BACKEND_PORT=5007
FRONTEND_PORT=3000

# Persistent Flask secret (any long random string). Optional for local use.
SECRET_KEY=

# Twilio credentials for SMS alerts (optional). The recipient number is set
# per project in the setup wizard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Threads handed to minimap2 / samtools per batch (default: min(4, cores)).
NANOCAS_THREADS=4

# Logging: DEBUG, INFO (default), WARNING
NANOCAS_LOG_LEVEL=INFO

# Restrict browser origins in production (default: *).
CORS_ALLOWED_ORIGINS=*
